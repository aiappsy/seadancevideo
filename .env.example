# ==========================================
# Seedance V2 Generator Environment Variables
# ==========================================

# NextAuth / App Settings
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google Auth (for user sign in)
# Get from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Firebase & Google Cloud Ecosystem
# On Google Cloud Run, Application Default Credentials (ADC) are used automatically.
# For local development or outside GCP, provide project credentials:
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="your_firebase_project_id.appspot.com"

# Seedance AI Generation (via MuAPI)
SEEDANCE_V2_API_KEY="your_seedance_v2_key_here"
WEBHOOK_URL="https://your-cloud-run-domain.a.run.app"

# Stripe (Credit Purchases & Billing)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Dynamic UI Theme (slate-indigo, cyberpunk, emerald, sunset)
NEXT_PUBLIC_THEME="slate-indigo"
NEXT_PUBLIC_APP_NAME="Seedance V2 Workspace"
